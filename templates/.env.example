# ============================================================
# CoworkOS Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# Anthropic
ANTHROPIC_API_KEY=your_api_key_here

# Outlook MCP (Personal - IMAP)
OUTLOOK_EMAIL=your_email@outlook.com
OUTLOOK_APP_PASSWORD=your_app_password_here

# Outlook MCP (Corporate - Microsoft Graph)
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=
OUTLOOK_REDIRECT_URI=http://localhost:3000/callback

# Desktop Commander
# No secrets needed - uses local filesystem

# CoworkOS
COWORK_ROOT={{COWORK_ROOT}}
